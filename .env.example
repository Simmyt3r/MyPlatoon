# ============================================================
# MyPlatoon - Environment Configuration Template
# Copy this file to ".env" for local development.
# NEVER commit the real ".env" file to GitHub.
# ============================================================

# --- Flask core ---
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-value
# Unique 32+ character token for first-time /setup, then REMOVE after admin creation.
SETUP_TOKEN=

# --- Aiven PostgreSQL for production ---
# In Vercel, set AIVEN_DATABASE_URL to the Aiven service's actual URI
# for database "myplatoon" with sslmode=require. Never commit a password.
# Empty here is intentional; local development continues to use DATABASE_URL.
AIVEN_DATABASE_URL=
# Optional development database (or sqlite:///dev.db).
DATABASE_URL=sqlite:///dev.db
# Put the real Aiven direct URL in a GitHub production secret named
# DATABASE_URL_UNPOOLED, NOT in this example file.
DATABASE_URL_UNPOOLED=

# --- Cloudinary (image storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Application ---
# Set this to your real deployed URL (not localhost) once you deploy --
# it's used to build the links QR codes point to, so a wrong value here
# means printed/shared QR codes lead nowhere useful.
APP_BASE_URL=http://localhost:5000
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=change-this-strong-password

# --- Branding ---
# This codebase is a generic community-directory platform -- everything
# below controls how THIS deployment is branded, with no code changes
# needed. Leave APP_SUBTITLE/APP_MOTTO/POWERED_BY blank to omit them from
# the UI entirely rather than showing empty text.
APP_NAME=MyPlatoon
APP_SHORT_NAME=MyPlatoon
APP_SUBTITLE=For PCMs, serving corps members and alumni
APP_MOTTO=
APP_TAGLINE=Your NYSC journey. Your platoon. Your people.
POWERED_BY=
APP_BRAND_INITIALS=MP
APP_MEMBER_LABEL=Member
APP_PRIMARY_COLOR=#0b7a3b
APP_ACCENT_COLOR=#c79a2e

# --- Rate limiting storage (optional, defaults to in-memory) ---
RATELIMIT_STORAGE_URI=memory://

# --- Schema management ---
# Use false in Vercel production; /setup supports protected admin migrations.
# Local development can use true when working with a fresh SQLite database.
AUTO_CREATE_TABLES=true

# --- Mail (optional enhancement, leave blank to disable email notices) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# --- Feature flags ---
# Turn the Dating feature on/off site-wide. When false, /dating routes
# 404 and the nav links are hidden -- the models/tables still exist,
# nothing is deleted.
ENABLE_DATING=true

# --- NERD guide: INDEPENDENT MyPlatoon support (not government support) ---
NERD_HELP_PHONE=09039930006
NERD_HELP_WHATSAPP_URL=https://wa.me/2349039930006
